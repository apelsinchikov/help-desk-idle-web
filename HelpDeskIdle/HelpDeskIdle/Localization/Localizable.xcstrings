    "hint.achievements": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Level a job up to a milestone and it gets faster or more profitable. The gallery shows what lies ahead."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокачай работу до нужного уровня — и она станет быстрее или прибыльнее. Галерея покажет, что ещё впереди."
          }
        }
      }
    },
    "hint.backpack": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perks live here. Switch one on when it helps most: speed while you play, rewind any time. Rewind pays only jobs with managers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут лежат перки. Включай, когда выгоднее всего: скорость — пока играешь, перемотку — когда угодно. Перемотка платит только за работы с менеджерами."
          }
        }
      }
    },
    "hint.managers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A manager collects the money and restarts the job. Even while you sleep. Especially while you sleep."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Менеджер сам собирает деньги и перезапускает работу. Даже когда ты спишь. Особенно когда ты спишь."
          }
        }
      }
    },
    "hint.speaker": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyudmila"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Людмила Петровна"
          }
        }
      }
    },
    "hint.upgrades": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay once, keep it forever. Well, until the next reorg."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платишь один раз — получаешь навсегда. Ну, до следующей реорганизации."
          }
        }
