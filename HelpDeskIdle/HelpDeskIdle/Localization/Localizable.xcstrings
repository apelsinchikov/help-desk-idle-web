    "ach.lyudmila.100": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyudmila: “The computer downloaded some program by itself. It's called “Soli-tai-re”.”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Людмила Петровна: «Компьютер сам скачал какую-то программу. Зовут «Коса-ры-нка».»"
          }
        }
      }
    },
    "ach.lyudmila.200": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyudmila: “Closing the quarter. Don't breathe on the server.”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Людмила Петровна: «Закрываем квартал. Не дышите на сервер.»"
          }
        }
      }
    },
    "ach.lyudmila.25": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyudmila: “The printer isn't printing again. No, I didn't touch it.”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Людмила Петровна: «Принтер опять не печатает. Нет, я его не трогала.»"
          }
        }
      }
    },
    "ach.lyudmila.300": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyudmila: “The ERP updated. Nothing works. Same as yesterday.”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Людмила Петровна: «1С обновилась. Ничего не работает. Как вчера.»"
          }
        }
      }
    },
    "ach.lyudmila.400": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyudmila: “Thank you, boys! Here's a chocolate bar.”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Людмила Петровна: «Спасибо, мальчики! Вот вам шоколадка.»"
          }
        }
      }
    },
    "ach.lyudmila.50": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyudmila: “Why is my internet gone? I only moved the plug.”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Людмила Петровна: «А почему у меня интернет пропал? Я только вилку переставила.»"
          }
        }
      }
    },
